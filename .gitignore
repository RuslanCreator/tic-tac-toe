*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Конфигурации сред разработки (IDE)
.idea/
.vscode/
*.swp
*.swo

# Файлы окружения с секретами (если появятся в будущем)
.env
.env.*

# Системные файлы
.DS_Store
Thumbs.db
